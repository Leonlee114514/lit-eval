# 复制为 .env 后填写。所有密钥只走 .env，勿提交仓库。
# ===== 后端 =====
# API 服务端口
PORT=8000

# 抓取限速礼貌：填入你的邮箱可提升 Crossref 限速池（50 req/s）
FETCHER_MAILTO=

# OpenAlex 免费 API key：额度提到 10×（https://openalex.org/settings/api）。
# 留空仍可用（mailto 认证档），但 OpenAlex 的 search 请求按 $1/1000 次计费、
# 比 list+filter（$0.10/1000）贵 10 倍，无 key 时更容易触顶日配额。
OPENALEX_API_KEY=

# ===== 检索式构造（主题搜索）=====
# raw      = 原样透传你的输入（OpenAlex 会把未分隔的词按 AND 处理）—— 默认
# expanded = 用同义词表做 OR 扩展 + 短语引号，超 URL 长度上限时自动切块取并集
# 调成 expanded 前，建议先用对比脚本在真实课题上验证效果：
#   python -m app.scripts.compare_search_modes "waterborne polyurethane coating"
SEARCH_QUERY_MODE=raw

# 附加同义词表（表层词=规范词，逗号分隔），与内置化学同义词表合并。
# 只填"语义等价"的词；填"相关但不同义"的词会引入噪声召回（缩写尤其容易）。
# 例：pu=polyurethane,coat=coating,wpu=waterborne polyurethane
SEARCH_EXTRA_SYNONYMS=

# ===== LLM 评估 =====
# none | openai_compat | ollama
LLM_PROVIDER=none
# 留空则自动降级为规则化分析（llm_assessment.source = "rule_based"）
# 任何 OpenAI 兼容端点都可用。已验证：
#   DeepSeek:  base https://api.deepseek.com/v1  model deepseek-chat
#   Kimi:      base https://api.moonshot.cn/v1    model moonshot-v1-8k
LLM_API_KEY=
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=moonshot-v1-8k

# ===== 相关性 =====
# 设为 1 启用 SBERT 语义相似度（需安装 requirements-sbert.txt）
USE_SBERT=0
# 设为 1 启用 fastembed 多语言语义向量（需安装 requirements-fastembed.txt；
# ONNX 轻量无需 torch，首次运行会从 HuggingFace 下载模型，
# 国内网络可设 HF_ENDPOINT=https://hf-mirror.com）
USE_FASTEMBED=0

# ===== PDF 下载（可选）=====
# Unpaywall 必填邮箱；留空回退 FETCHER_MAILTO
UNPAYWALL_EMAIL=
# Sci-Hub 通道代理；留空 = 不走代理
SCIHUB_PROXY=
# 是否允许尝试浏览器腿（WebBridge），运行时探测不在线会自动降级跳过
USE_WEBBRIDGE=1
WEBBRIDGE_URL=http://127.0.0.1:10086
WEBBRIDGE_SESSION=scihub
